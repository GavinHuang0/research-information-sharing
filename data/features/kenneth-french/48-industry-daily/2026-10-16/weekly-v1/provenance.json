{
  "dataset_id": "kenneth-french/48-industry-daily",
  "definitions": {
    "annualization": "none",
    "available_at": "after_origin_Friday_close_in_fixed_source_snapshot",
    "calendar_policy": "retain_all_intervening_and_partial_endpoint_calendar_weeks",
    "centering": "none",
    "endpoint_policy": "same_minimum_count_rule_as_other_weeks; final_incomplete_week_may_have_only_counts",
    "features": {
      "log_variance": {
        "filename": "log_weekly_variance.csv",
        "formula": "log_weekly_variance_plus_offset",
        "units": "log_decimal_return_squared"
      },
      "log_variance_mean_12w": {
        "filename": "mean_log_variance_12w.csv",
        "formula": "arithmetic_mean_log_variance_current_and_previous_11_weeks",
        "units": "log_decimal_return_squared"
      },
      "log_variance_mean_4w": {
        "filename": "mean_log_variance_4w.csv",
        "formula": "arithmetic_mean_log_variance_current_and_previous_3_weeks",
        "units": "log_decimal_return_squared"
      },
      "observed_daily_counts": {
        "filename": "observed_daily_counts.csv",
        "formula": "count_nonmissing_source_daily_returns",
        "units": "observations"
      },
      "variance": {
        "filename": "weekly_variance.csv",
        "formula": "sum_daily_decimal_returns_squared",
        "units": "decimal_return_squared"
      },
      "volatility": {
        "filename": "weekly_volatility.csv",
        "formula": "sqrt_weekly_variance",
        "units": "decimal_return"
      }
    },
    "frequency": "W-FRI",
    "history_windows_weeks": [
      1,
      4,
      12
    ],
    "interval": "(previous_Friday,current_Friday]",
    "log_offset": 1e-08,
    "logarithm": "natural",
    "minimum_observed_daily_returns": 3,
    "missingness_policy": "no_fill_no_interpolation; insufficient_count_measures_are_missing",
    "note": "Close-to-close return-variation proxies, not intraday realized variance or latent conditional variance. Historic Saturday observations are included, so counts can exceed five.",
    "rolling_window": "current_week_and_preceding_calendar_weeks_require_complete_window",
    "scaling_or_fitted_transforms": "none"
  },
  "feature_version": "weekly-v1",
