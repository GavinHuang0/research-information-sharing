# Preserve checksum-verified research inputs on every operating system.
data/**/*.csv text eol=lf
data/**/*.json text eol=lf
*.zip binary
# Preparation provenance includes byte fingerprints of these Python sources.
scripts/*.py text eol=lf
src/factorcast/retrieval.py text eol=lf
# Frozen experiment checksums must survive Windows and Unix checkouts.
configs/fixed_pilot.toml text eol=lf
configs/experiment_02.toml text eol=lf
configs/experiment_03.toml text eol=lf
results/**/*.csv text eol=lf
results/**/*.json text eol=lf
results/**/*.md text eol=lf
results/**/*.txt text eol=lf
results/**/*.toml text eol=lf
results/**/*.log binary
*.gz binary
*.npz binary
*.npy binary
# Canonical progress sources and generated LaTeX use stable line endings.
proposal/progress.md text eol=lf
proposal/*.tex text eol=lf
proposal/*.lua text eol=lf
proposal/progress_sync.json text eol=lf
proposal/**/*.pdf binary
# Preserve the original proposal's historical bytes, including original CRLF.
proposal/archive/** -text -whitespace
